{
    "$schema": "https://omeka-s-contrib.github.io/omeka-s-blueprints/schema/v0/blueprint-schema.json",
    "meta": {
        "title": "Demo site",
        "description": "Example omeka-s-cli blueprint deploying a small environment."
    },
    // Used by the core phase only. The admin password comes from --admin-password (default: admin).
    "install": {
        "title": "Blueprint Demo",
        "admin": { "name": "Blueprint Admin", "email": "admin@example.com" }
    },
    "modules": [
        // Pull in modules from a shared, reusable list.
        { "$import": "./modules.extra.jsonc" },
        // Custom modules for this blueprint.
        { "name": "ValueSuggest", "state": "activate" },
        { "name": "FacetedBrowse", "state": "activate" },
        { "name": "Mapping", "state": "activate" },
    ],
    "themes": [
        // The default theme ships with the core, so there is nothing to download.
        "default"
    ],
    "vocabularies": [
        {
            "prefix": "schema",
            "namespaceUri": "https://schema.org/",
            "label": "schema.org",
            "source": "https://schema.org/version/latest/schemaorg-current-https.rdf"
        }
    ],
    "resourceTemplates": [
        { "source": "../resource-template/base_resource.json" }
    ],
    "settings": {
        "installation_title": "Blueprint Demo"
    }
}
